{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "СБИС: клиенты списка 93332",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli.sbis_clients_console",
            "args": [
                "93332"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "СБИС: открытые организации за сегодня → БД",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/testParseCompany.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Telegram: 3 клиент[а] с записью в БД",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli.telegram_enrichment",
            "args": [
                "--limit",
                "3",
                "--timeout",
                "10",
                "--write"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Telegram: последнее сообщение (без записи)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli.telegram_last_message",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Telegram: последнее сообщение (записать в БД)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.cli.telegram_last_message",
            "args": [
                "--write"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
